# ---------------------------------------------------------------------------
# Saaf Hawa environment variables
#
# The app works out of the box with keyless live data from Open-Meteo
# (air quality + weather + geocoding). Every key below is OPTIONAL.
#
# All keys are server-side only. Never prefix a secret with NEXT_PUBLIC_ —
# anything with that prefix is bundled into client JavaScript.
# ---------------------------------------------------------------------------

# Optional: India CPCB / data.gov.in API key (primary Indian source)
CPCB_API_KEY=

# Optional: override the data.gov.in CPCB resource id (defaults to the
# current national AQI resource)
CPCB_RESOURCE_ID=

# Optional: World Air Quality Index token (station-level fallback)
WAQI_TOKEN=

# Optional: OpenWeatherMap key (weather fallback/alternative to Open-Meteo)
OPENWEATHER_API_KEY=

# Optional: Google Gemini key for the conversational assistant.
# Without it, the assistant uses a deterministic, data-grounded responder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
